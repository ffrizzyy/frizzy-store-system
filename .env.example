# Contoh nama variabel. Tidak ada nilai rahasia yang di-commit.
# Frizzy berjalan tanpa backend, jadi semua variabel di bawah opsional.
# Isi hanya bila menyambungkan Frizzy ke layanan nyata.

# --- Basis data dan analitik ---
DATABASE_URL=
DATABASE_READONLY_URL=
ANALYTICS_SERVICE_URL=
ANALYTICS_SERVICE_TOKEN=

# --- Autentikasi dan enkripsi ---
AUTH_SECRET=
ENCRYPTION_KEY=

# --- Cache dan pembatasan laju ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email struk dan permintaan ulasan ---
RESEND_API_KEY=
EMAIL_FROM=
SHOP_REPLY_TO=

# --- Pembayaran (QRIS / VA / e-wallet) ---
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Penyimpanan objek (foto produk, invoice, PDF) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- AI Analyst (kunci hanya di server, tidak pernah ke browser) ---
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_IDR=

# --- Perlindungan bot di halaman masuk dan formulir publik ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ulasan Google dan lokasi ---
GOOGLE_PLACE_ID=

# --- Observabilitas ---
SENTRY_DSN=
POSTHOG_KEY=

# --- Aplikasi ---
APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# --- Runtime proses Node ---
# Image Docker sudah menetapkan nilai ini; buka komentar hanya bila menjalankan
# server standalone secara manual dan ingin menimpanya.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
